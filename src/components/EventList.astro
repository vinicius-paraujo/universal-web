---
interface EventItem {
	name: string;
	shortName: string;
	type: string;
	date: string;
	location: string;
	participation: string;
	href: string;
}

interface Props {
	title: string;
	introduction: string;
	items: EventItem[];
	labels: { date: string; location: string; participation: string; website: string; websiteAriaPrefix: string };
}

const { title, introduction, items, labels } = Astro.props;
---

<section class="events" id="eventos" aria-labelledby="events-title" tabindex="-1">
	<div class="container events-inner">
		<header>
			<h2 id="events-title">{title}</h2>
			<p>{introduction}</p>
		</header>

		<div class="event-list">
			{items.map((event) => (
				<article>
					<div class="event-heading">
						<p><span>{event.type}</span><span>{event.shortName}</span></p>
						<h3>{event.name}</h3>
					</div>
					<dl class="event-facts">
						<div><dt>{labels.date}</dt><dd>{event.date}</dd></div>
						<div><dt>{labels.location}</dt><dd>{event.location}</dd></div>
					</dl>
					<div class="event-footer">
						<p><span>{labels.participation}</span>{event.participation}</p>
						<a href={event.href} aria-label={`${labels.websiteAriaPrefix} ${event.shortName}`}>
							{labels.website}
							<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
								<path d="M4 14 14 4M7 4h7v7" fill="none" stroke="currentColor" stroke-width="1.5" />
							</svg>
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.events {
		padding-block: var(--space-9);
		background: linear-gradient(115deg, var(--color-hero-start), var(--color-hero-end));
		border-top: 1px solid var(--color-border);
	}

	.events-inner,
	header {
		display: grid;
		gap: var(--space-7);
	}

	header {
		align-content: start;
		gap: var(--space-4);
	}

	header p {
		max-width: 36rem;
		font-size: var(--text-lead);
	}

	.event-list article {
		display: grid;
		gap: var(--space-6);
		padding: clamp(1.5rem, 4vw, 3rem);
		background: rgb(17 18 24 / 55%);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
	}

	.event-heading {
		display: grid;
		gap: var(--space-3);
	}

	.event-heading p {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		color: var(--color-accent);
		font-size: var(--text-small);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.event-heading p span + span::before {
		content: '\00b7';
		margin-right: var(--space-4);
	}

	h3 {
		max-width: 22ch;
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 400;
		line-height: 1.2;
	}

	.event-facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, max-content));
		gap: var(--space-4) var(--space-8);
		margin: 0;
		padding-block: var(--space-4);
		border-block: 1px solid var(--color-border);
	}

	.event-facts div {
		display: grid;
		gap: var(--space-1);
	}

	dt {
		color: var(--color-muted);
		font-size: var(--text-small);
	}

	dd {
		margin: 0;
	}

	.event-footer {
		display: grid;
		gap: var(--space-6);
	}

	.event-footer p {
		display: grid;
		gap: var(--space-1);
		margin: 0;
	}

	.event-footer p span {
		color: var(--color-muted);
		font-size: var(--text-small);
	}

	.event-footer a {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		width: fit-content;
		min-height: 46px;
		padding: var(--space-2) var(--space-5);
		overflow: hidden;
		justify-self: center;
		border: 1px solid var(--color-accent);
		border-radius: var(--radius-small);
		color: var(--color-text);
		font-weight: 600;
		text-decoration: none;
		transition: color var(--transition-fast), border-color var(--transition-fast);
		isolation: isolate;
	}

	.event-footer a::before {
		position: absolute;
		z-index: -1;
		inset: 0;
		background: var(--color-accent);
		content: '';
		transform: translateY(100%);
		transition: transform var(--transition-fast);
	}

	.event-footer a:hover,
	.event-footer a:focus-visible {
		color: var(--color-header);
		border-color: var(--color-focus);
	}

	.event-footer a:hover::before,
	.event-footer a:focus-visible::before {
		transform: translateY(0);
	}

	@media (min-width: 64rem) {
		.event-list article {
			padding-inline: var(--space-7);
		}
	}
</style>
