---
import Navigation, { type NavigationItem } from './Navigation.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { HomeContent } from '../content/home';

interface Props {
	navigation: NavigationItem[];
	locale: 'pt-br' | 'en';
	ui: HomeContent['ui'];
}

const { navigation, locale, ui } = Astro.props;
const homePath = locale === 'en' ? '/en/' : '/';
---

<header>
	<div class="container header-inner">
		<div class="brand-group">
			<a class="universal" href={homePath} aria-label="Universal">
				<img class="universal-symbol" src="/brand/universal-symbol.svg" alt="" width="320" height="320" />
				<img class="universal-wordmark" src="/brand/universal-wordmark.svg" alt="Universal" width="600" height="180" />
			</a>
			<span class="brand-divider" aria-hidden="true"></span>
			<a class="university" href="https://www.ufc.br/">
				<img src="/brand/ufc-horizontal-white.png" alt="Universidade Federal do Ceará" width="995" height="268" />
			</a>
		</div>
		<div class="header-actions">
			<div class="navigation"><Navigation items={navigation} label={ui.navigationLabel} menuLabel={ui.menuLabel} /></div>
			<LanguageSwitcher currentLocale={locale} label={ui.languageLabel} currentLabel={ui.currentLanguage} />
		</div>
	</div>
</header>

<style>
	header {
		background: var(--color-header);
		border-bottom: 1px solid var(--color-border);
	}

	.header-inner {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: 7rem;
		padding-block: var(--space-3);
	}

	.brand-group {
		display: grid;
		align-items: start;
		gap: var(--space-2);
	}

	.universal {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		width: clamp(9rem, 42vw, 14rem);
	}

	.universal-symbol {
		width: 30%;
		flex: 0 0 auto;
	}

	.universal-wordmark {
		width: 70%;
		filter: grayscale(1) brightness(1.55);
	}

	.brand-divider {
		display: none;
		width: 1px;
		height: 2.75rem;
		background: var(--color-border);
	}

	.university {
		display: block;
		width: 7.25rem;
		opacity: 0.8;
	}

	.navigation {
		justify-self: end;
	}

	.header-actions { display: flex; min-width: 0; flex: 0 0 auto; align-items: center; gap: var(--space-3); }

	@media (max-width: 39.99rem) {
		.header-inner { display: grid; grid-template-columns: 1fr; gap: var(--space-3); padding-block: var(--space-4); }
		.header-actions { width: 100%; justify-content: flex-end; }
	}

	@media (min-width: 64rem) {
		.header-inner {
			min-height: 7.5rem;
			gap: var(--space-8);
		}

		.brand-group {
			display: flex;
			align-items: center;
			gap: var(--space-5);
		}

		.brand-divider {
			display: block;
		}

		.university {
			width: 9rem;
		}
	}
</style>
