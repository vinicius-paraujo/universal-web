---
export interface NavigationItem {
	label: string;
	href: string;
}

interface Props {
	items: NavigationItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Principal">
	<ul class="wide-navigation">
		{items.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
	</ul>
	<details class="compact-navigation">
		<summary>
			Menu
			<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
				<path d="M3 6h12M3 12h12" fill="none" stroke="currentColor" stroke-width="1.5" />
			</svg>
		</summary>
		<ul>
			{items.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
		</ul>
	</details>
</nav>

<script>
	document.querySelectorAll<HTMLDetailsElement>('.compact-navigation').forEach((menu) => {
		const summary = menu.querySelector('summary');
		menu.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.open) {
				menu.open = false;
				summary?.focus();
			}
		});
		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				menu.open = false;
				const destination = new URL(link.href);
				if (destination.pathname === location.pathname && destination.hash) {
					document.getElementById(destination.hash.slice(1))?.focus({ preventScroll: true });
				}
			});
		});
	});
</script>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	a {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: var(--space-2) var(--space-4);
		color: var(--color-muted);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 0.975rem;
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	a:hover {
		color: var(--color-text);
	}

	a::after {
		position: absolute;
		inset: auto var(--space-4) 0;
		height: 1px;
		background: var(--color-accent);
		content: '';
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--transition-fast);
	}

	a:hover::after,
	a:focus-visible::after {
		transform: scaleX(1);
	}

	.wide-navigation {
		display: none;
		gap: var(--space-3);
	}

	summary {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		min-height: 44px;
		padding: var(--space-2) var(--space-3);
		list-style: none;
		cursor: pointer;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 0.975rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
	}

	summary::-webkit-details-marker {
		display: none;
	}

	details[open] summary {
		background: var(--color-surface);
	}

	.compact-navigation ul {
		position: absolute;
		z-index: 2;
		inset-inline: 0;
		top: calc(100% - 1px);
		padding: var(--space-4);
		background: var(--color-header);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-menu);
	}

	@media (min-width: 75rem) {
		.wide-navigation {
			display: flex;
		}

		.compact-navigation {
			display: none;
		}
	}
</style>
