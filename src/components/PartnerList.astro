---
interface Partner {
	name: string;
	shortName: string;
	role: string;
	href: string;
	logo?: string;
}

interface Props {
	title: string;
	introduction: string;
	items: Partner[];
}

const { title, introduction, items } = Astro.props;
---

<section class="partners" id="parceiros" aria-labelledby="partners-title" tabindex="-1">
	<div class="container partners-inner">
		<header>
			<h2 id="partners-title">{title}</h2>
			<p>{introduction}</p>
		</header>

		<ul class="partner-list">
			{items.map((partner) => (
				<li>
					<a href={partner.href} aria-label={`${partner.name} — ${partner.role}`}>
						{partner.logo
							? <img class="partner-logo" src={partner.logo} alt={partner.shortName} width="440" height="120" />
							: <span class="short-name" aria-hidden="true">{partner.shortName}</span>}
						<span class="partner-detail">
							<strong>{partner.name}</strong>
							<span>{partner.role}</span>
						</span>
						<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
							<path d="M5 15 15 5m-7 0h7v7" fill="none" stroke="currentColor" stroke-width="1.5" />
						</svg>
					</a>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.partners {
		padding-block: var(--space-9);
		background: var(--color-surface);
		border-top: 1px solid var(--color-border);
	}

	.partners-inner {
		display: grid;
		gap: var(--space-7);
	}

	header {
		display: grid;
		align-content: start;
		gap: var(--space-4);
	}

	header p {
		max-width: 34rem;
		font-size: var(--text-lead);
	}

	.partner-list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
	}

	.partner-list li {
		border-bottom: 1px solid var(--color-border);
	}

	.partner-list a {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-5);
		min-height: 7rem;
		padding: var(--space-4);
		color: var(--color-text);
		text-decoration: none;
		transition: background-color var(--transition-fast), color var(--transition-fast);
	}

	.partner-list a:hover,
	.partner-list a:focus-visible {
		background: var(--color-hero-start);
		color: var(--color-focus);
	}

	.short-name {
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1.5rem, 3vw, 2.25rem);
	}

	.partner-logo {
		width: clamp(7rem, 12vw, 10rem);
		border-radius: 2px;
	}

	.short-name,
	.partner-logo {
		grid-column: 1;
	}

	.partner-detail {
		grid-column: 1;
	}

	.partner-list svg {
		grid-column: 2;
		grid-row: 1 / 3;
	}

	.partner-detail {
		display: grid;
		gap: var(--space-1);
	}

	.partner-detail strong {
		font-weight: 500;
	}

	.partner-detail > span {
		color: var(--color-muted);
		font-size: var(--text-small);
	}

	@media (min-width: 64rem) {
		.partners-inner {
			grid-template-columns: minmax(18rem, 0.9fr) minmax(0, 1fr);
			gap: var(--space-8);
		}

		.partner-list a {
			grid-template-columns: minmax(7rem, auto) minmax(0, 1fr) auto;
		}

		.short-name,
		.partner-logo,
		.partner-detail,
		.partner-list svg {
			grid-column: auto;
			grid-row: auto;
		}
	}
</style>
