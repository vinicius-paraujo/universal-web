---
interface Partner {
	name: string;
	role: string;
	href: string;
	logo: string;
}

interface Props {
	title: string;
	introduction: string;
	items: Partner[];
}

const { title, introduction, items } = Astro.props;
---

<section class="partners" id="parceiros" aria-labelledby="partners-title" tabindex="-1">
	<div class="container partners-inner">
		<header>
			<h2 id="partners-title">{title}</h2>
			<p>{introduction}</p>
		</header>

		<ul class="partner-list">
			{items.map((partner) => (
				<li>
					<a href={partner.href} aria-label={`${partner.name} — ${partner.role}`}>
						<span class="logo-area">
							<img class="partner-logo" src={partner.logo} alt={partner.name} />
						</span>
						<span class="partner-detail">
							<span>{partner.role}</span>
						</span>
						<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
							<path d="M5 15 15 5m-7 0h7v7" fill="none" stroke="currentColor" stroke-width="1.5" />
						</svg>
					</a>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.partners {
		padding-block: var(--space-9);
		background: var(--color-surface);
		border-top: 1px solid var(--color-border);
	}

	.partners-inner {
		display: grid;
		gap: var(--space-7);
	}

	header {
		display: grid;
		align-content: start;
		gap: var(--space-4);
	}

	header p {
		max-width: 34rem;
		font-size: var(--text-lead);
	}

	.partner-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
		border-left: 1px solid var(--color-border);
	}

	.partner-list li {
		border-bottom: 1px solid var(--color-border);
		border-right: 1px solid var(--color-border);
	}

	.partner-list a {
		position: relative;
		display: flex;
		min-height: 12rem;
		flex-direction: column;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-5);
		padding: var(--space-5);
		color: var(--color-text);
		text-decoration: none;
		transition: background-color var(--transition-fast), color var(--transition-fast);
	}

	.partner-list a:hover,
	.partner-list a:focus-visible {
		background: var(--color-hero-start);
		color: var(--color-focus);
	}

	.logo-area {
		display: flex;
		width: 100%;
		height: 5.5rem;
		align-items: center;
	}

	.partner-logo {
		display: block;
		width: auto;
		max-width: min(100%, 12rem);
		max-height: 4.5rem;
		object-fit: contain;
		object-position: left center;
	}

	.partner-list svg {
		position: absolute;
		right: var(--space-4);
		bottom: var(--space-4);
	}

	.partner-detail {
		display: grid;
		gap: var(--space-1);
	}

	.partner-detail > span {
		display: block;
		max-width: 19rem;
		padding-right: var(--space-6);
		color: var(--color-muted);
		font-size: var(--text-small);
	}

</style>
