---
export interface ProjectResource {
	label: string;
	href: string;
	type: 'demonstracao' | 'video' | 'artigo' | 'documentacao' | 'codigo' | 'resultado';
}

export interface ProjectSummary {
	id: string;
	title: string;
	summary: string;
	description?: string[];
	logo?: string;
	areas: string[];
	resources?: ProjectResource[];
}

interface Props {
	title: string;
	introduction: string;
	items: ProjectSummary[];
}

const { title, introduction, items } = Astro.props;
---

<section class="projects" id="projetos" aria-labelledby="projects-title" tabindex="-1">
	<div class="container">
		<header class="section-heading">
			<h2 id="projects-title">{title}</h2>
			<p>{introduction}</p>
		</header>

		<div class="project-list" aria-label="Projetos do Universal">
			{items.map((project, index) => (
				<article class="project" id={project.id}>
					<div class="project-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
					<div class="project-identity">
						<div class="project-name">
							{project.logo && <img class="project-logo" src={project.logo} alt="" width="512" height="512" />}
							<h3>{project.title}</h3>
						</div>
						<ul class="areas" aria-label="Áreas relacionadas">
							{project.areas.map((area) => <li>{area}</li>)}
						</ul>
					</div>
					<div class="project-detail">
						<p class="summary">{project.summary}</p>
						{project.description?.map((paragraph) => <p>{paragraph}</p>)}
						{project.resources && project.resources.length > 0 && (
							<ul class="resources" aria-label={`Recursos de ${project.title}`}>
								{project.resources.map((resource) => <li><a href={resource.href}>{resource.label}</a></li>)}
							</ul>
						)}
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.projects {
		padding-block: var(--space-9);
		background: var(--color-page);
	}

	.section-heading {
		display: grid;
		gap: var(--space-4);
		margin-bottom: var(--space-7);
	}

	.section-heading p {
		max-width: 42rem;
		font-size: var(--text-lead);
	}

	.project-list {
		display: grid;
		gap: var(--space-5);
	}

	.project {
		position: relative;
		display: grid;
		gap: var(--space-6);
		min-height: 24rem;
		padding: clamp(1.5rem, 5vw, 4rem);
		overflow: hidden;
		background: linear-gradient(125deg, #262331 0%, var(--color-surface) 58%, #1b1c24 100%);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
	}

	.project::before {
		position: absolute;
		inset: 0 auto 0 0;
		width: 3px;
		background: var(--color-accent);
		content: '';
	}

	.project-index {
		color: var(--color-accent);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: var(--text-small);
		letter-spacing: 0.12em;
	}

	.project-identity {
		display: grid;
		align-content: start;
		gap: var(--space-6);
	}

	.project-name {
		display: flex;
		align-items: center;
		gap: var(--space-5);
	}

	.project-logo {
		width: clamp(4rem, 8vw, 6rem);
		flex: 0 0 auto;
	}

	h3 {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.project-detail {
		display: grid;
		align-content: end;
		gap: var(--space-5);
		max-width: 36rem;
	}

	.summary {
		font-size: var(--text-lead);
		color: var(--color-text);
	}

	.areas,
	.resources {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.areas li {
		padding: var(--space-2) var(--space-3);
		color: var(--color-muted);
		font-size: var(--text-small);
		border: 1px solid var(--color-border);
		border-radius: 999px;
	}

	.resources a {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		padding-inline: var(--space-4);
		border: 1px solid var(--color-accent);
		border-radius: var(--radius-small);
		text-decoration: none;
	}

	@media (min-width: 64rem) {
		.project {
			grid-template-columns: auto minmax(20rem, 0.85fr) minmax(24rem, 1fr);
			align-items: stretch;
			gap: var(--space-7);
		}
	}
</style>
