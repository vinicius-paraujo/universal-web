---
interface ResultItem {
	kind: string;
	title: string;
	description: string;
	project?: string;
	citation?: string;
	youtubeId?: string;
	href?: string;
}

interface Props {
	title: string;
	introduction: string;
	items: ResultItem[];
}

const { title, introduction, items } = Astro.props;
---

<section class="results" id="resultados" aria-labelledby="results-title" tabindex="-1">
	<div class="container">
		<header class="section-heading">
			<h2 id="results-title">{title}</h2>
			<p>{introduction}</p>
		</header>

		<div class="result-grid">
			{items.map((result) => (
				<article class:list={['result', { 'result-video': result.youtubeId }]}>
					{result.youtubeId && (
						<div class="video">
							<iframe
								src={`https://www.youtube-nocookie.com/embed/${result.youtubeId}`}
								title={result.title}
								loading="lazy"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
								allowfullscreen
							></iframe>
						</div>
					)}

					<div class="result-content">
						<div class="result-meta">
							<span>{result.kind}</span>
							{result.project && <span>{result.project}</span>}
						</div>
						<h3>{result.title}</h3>
						<p>{result.description}</p>
						{result.citation && <p class="citation">{result.citation}</p>}
						{result.href && <a href={result.href}>Acessar resultado</a>}
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.results {
		padding-block: var(--space-9);
		background: var(--color-page);
		border-top: 1px solid var(--color-border);
	}

	.section-heading {
		display: grid;
		gap: var(--space-4);
		margin-bottom: var(--space-7);
	}

	.section-heading p {
		max-width: 45rem;
		font-size: var(--text-lead);
	}

	.result-grid {
		display: grid;
		gap: var(--space-5);
	}

	.result {
		display: grid;
		align-content: start;
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
	}

	.result-content {
		display: grid;
		align-content: start;
		gap: var(--space-5);
		padding: clamp(1.5rem, 4vw, 3rem);
	}

	.result-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
		color: var(--color-accent);
		font-size: var(--text-small);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	h3 {
		max-width: 24ch;
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1.6rem, 3vw, 2.35rem);
		font-weight: 400;
		line-height: 1.2;
		text-wrap: balance;
	}

	.citation {
		padding-top: var(--space-5);
		font-size: var(--text-small);
		border-top: 1px solid var(--color-border);
	}

	.result a {
		width: fit-content;
	}

	.video {
		aspect-ratio: 16 / 9;
		background: var(--color-header);
		border-bottom: 1px solid var(--color-border);
	}

	.video iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	@media (min-width: 64rem) {
		.result-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: start;
		}
	}
</style>
